<UserControl
  x:Class="Centerly.App.Views.RunningAppsPicker"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:conv="clr-namespace:Centerly.App.Converters"
  xmlns:res="clr-namespace:Centerly.App.Resources"
  xmlns:vm="clr-namespace:Centerly.App.ViewModels"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance vm:RunningAppsPickerViewModel}"
  Width="420">

  <UserControl.Resources>
    <conv:NullToVisibilityConverter x:Key="NullToVisible" />
    <conv:NullToVisibilityConverter x:Key="NullToCollapsed" Invert="True" />
    <conv:BoolToVisibilityConverter x:Key="TrueToVisible" />
  </UserControl.Resources>

  <StackPanel>
    <ui:TextBox
      x:Name="FilterBox"
      PlaceholderText="{x:Static res:Strings.PickerSearch}"
      Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
      Margin="0,0,0,8">
      <ui:TextBox.Icon>
        <ui:SymbolIcon Symbol="Search24" />
      </ui:TextBox.Icon>
    </ui:TextBox>

    <ui:TextBlock
      Appearance="Secondary"
      Margin="0,8"
      TextWrapping="Wrap"
      Text="{x:Static res:Strings.PickerEmpty}"
      Visibility="{Binding IsEmpty, Converter={StaticResource TrueToVisible}}" />

    <ListBox
      Height="320"
      ItemsSource="{Binding View}"
      SelectedItem="{Binding Selected}"
      MouseDoubleClick="OnItemDoubleClick"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      AutomationProperties.Name="{x:Static res:Strings.PickerTitle}">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:RunningAppItem}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="32" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Width="24" Height="24" Source="{Binding Icon}" Visibility="{Binding Icon, Converter={StaticResource NullToCollapsed}}" />
            <ui:SymbolIcon Symbol="AppGeneric24" FontSize="22" Visibility="{Binding Icon, Converter={StaticResource NullToVisible}}" />
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
              <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
              <ui:TextBlock Appearance="Secondary" FontTypography="Caption" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding App.ProcessName, Mode=OneWay}" />
                <Run Text="·" />
                <Run Text="{Binding App.WindowTitle, Mode=OneWay}" />
              </ui:TextBlock>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </StackPanel>
</UserControl>
