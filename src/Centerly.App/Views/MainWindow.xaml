<ui:FluentWindow
  x:Class="Centerly.App.Views.MainWindow"
  x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  xmlns:controls="clr-namespace:Centerly.App.Controls"
  xmlns:conv="clr-namespace:Centerly.App.Converters"
  xmlns:res="clr-namespace:Centerly.App.Resources"
  xmlns:vm="clr-namespace:Centerly.App.ViewModels"
  mc:Ignorable="d"
  d:DataContext="{d:DesignInstance vm:MainViewModel}"
  Title="Centerly"
  Icon="pack://application:,,,/Assets/app.ico"
  Width="700"
  Height="820"
  MinWidth="540"
  MinHeight="480"
  WindowStartupLocation="CenterScreen"
  ExtendsContentIntoTitleBar="True"
  WindowBackdropType="Mica"
  WindowCornerPreference="Round">

  <ui:FluentWindow.Resources>
    <conv:NullToVisibilityConverter x:Key="NullToVisible" />
    <conv:NullToVisibilityConverter x:Key="NullToCollapsed" Invert="True" />
    <conv:BoolToVisibilityConverter x:Key="TrueToVisible" />
    <conv:BoolToVisibilityConverter x:Key="FalseToVisible" Invert="True" />

    <Style x:Key="CardTitle" TargetType="ui:TextBlock">
      <Setter Property="FontTypography" Value="BodyStrong" />
    </Style>
    <Style x:Key="CardDescription" TargetType="ui:TextBlock">
      <Setter Property="Appearance" Value="Secondary" />
      <Setter Property="FontTypography" Value="Caption" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:TitleBar Grid.Row="0" Title="Centerly" ShowMaximize="False">
      <ui:TitleBar.Icon>
        <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" />
      </ui:TitleBar.Icon>
    </ui:TitleBar>

    <!-- Always visible: messages and the master switch. -->
    <StackPanel Grid.Row="1" Margin="24,8,24,0">
      <ui:TextBlock FontTypography="Title" Text="{x:Static res:Strings.MainTitle}" Margin="0,0,0,12" />

      <ui:InfoBar
        Margin="0,0,0,4"
        Title="{Binding MessageTitle}"
        Message="{Binding MessageText}"
        Severity="{Binding MessageSeverity}"
        IsOpen="{Binding IsMessageOpen, Mode=TwoWay}"
        IsClosable="True" />

      <ui:CardControl Margin="0,8,0,0">
        <ui:CardControl.Icon>
          <ui:SymbolIcon Symbol="Power24" />
        </ui:CardControl.Icon>
        <ui:CardControl.Header>
          <StackPanel>
            <ui:TextBlock Style="{StaticResource CardTitle}" Text="{x:Static res:Strings.EnabledTitle}" />
            <ui:TextBlock Style="{StaticResource CardDescription}" Text="{x:Static res:Strings.EnabledDescription}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch IsChecked="{Binding IsEnabled}" AutomationProperties.Name="{x:Static res:Strings.EnabledTitle}" />
      </ui:CardControl>
    </StackPanel>

    <TabControl Grid.Row="2" Margin="24,12,12,0">
      <TabControl.Resources>
        <!-- The WPF-UI template paints the selected tab with these keys: use the system accent instead of gray. -->
        <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="{DynamicResource SystemAccentColorSecondary}" />
        <SolidColorBrush x:Key="TabViewSelectedItemBorderBrush" Color="{DynamicResource SystemAccentColorSecondary}" />
        <SolidColorBrush x:Key="TabViewItemForegroundSelected" Color="{DynamicResource TextOnAccentFillColorPrimary}" />
      </TabControl.Resources>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Keyboard24" Margin="0,0,6,0" />
            <TextBlock Text="{x:Static res:Strings.SectionHotkeys}" />
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,12,12,24">
            <ui:CardControl Margin="0,0,0,4">
              <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Keyboard24" />
              </ui:CardControl.Icon>
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Style="{StaticResource CardTitle}" Text="{x:Static res:Strings.HotkeyCenterTitle}" />
                  <ui:TextBlock Style="{StaticResource CardDescription}" Text="{x:Static res:Strings.HotkeyHint}" />
                </StackPanel>
              </ui:CardControl.Header>
              <controls:HotkeyBox
                Width="220"
                Style="{StaticResource {x:Type TextBox}}"
                HorizontalContentAlignment="Center"
                Hotkey="{Binding CenterHotkey}"
                IsRecording="{Binding IsRecordingHotkey}"
                AutomationProperties.Name="{x:Static res:Strings.HotkeyCenterTitle}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4">
              <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="DesktopArrowRight24" />
              </ui:CardControl.Icon>
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Style="{StaticResource CardTitle}" Text="{x:Static res:Strings.HotkeyNextMonitorTitle}" />
                  <ui:TextBlock Style="{StaticResource CardDescription}" Text="{x:Static res:Strings.HotkeyNextMonitorDescription}" />
                </StackPanel>
              </ui:CardControl.Header>
              <controls:HotkeyBox
                Width="220"
                Style="{StaticResource {x:Type TextBox}}"
                HorizontalContentAlignment="Center"
                Hotkey="{Binding NextMonitorHotkey}"
                IsRecording="{Binding IsRecordingHotkey}"
                AutomationProperties.Name="{x:Static res:Strings.HotkeyNextMonitorTitle}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4">
              <ui:CardControl.Icon>
                <!-- There is no "arrow left" variant of this symbol, mirror the right one. -->
                <ui:SymbolIcon Symbol="DesktopArrowRight24" RenderTransformOrigin="0.5,0.5">
                  <ui:SymbolIcon.RenderTransform>
                    <ScaleTransform ScaleX="-1" />
                  </ui:SymbolIcon.RenderTransform>
                </ui:SymbolIcon>
              </ui:CardControl.Icon>
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Style="{StaticResource CardTitle}" Text="{x:Static res:Strings.HotkeyPreviousMonitorTitle}" />
                  <ui:TextBlock Style="{StaticResource CardDescription}" Text="{x:Static res:Strings.HotkeyPreviousMonitorDescription}" />
                </StackPanel>
              </ui:CardControl.Header>
              <controls:HotkeyBox
                Width="220"
                Style="{StaticResource {x:Type TextBox}}"
                HorizontalContentAlignment="Center"
                Hotkey="{Binding PreviousMonitorHotkey}"
                IsRecording="{Binding IsRecordingHotkey}"
                AutomationProperties.Name="{x:Static res:Strings.HotkeyPreviousMonitorTitle}" />
            </ui:CardControl>

            <ui:CardControl>
              <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="ArrowUndo24" />
              </ui:CardControl.Icon>
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Style="{StaticResource CardTitle}" Text="{x:Static res:Strings.HotkeyUndoTitle}" />
                  <ui:TextBlock Style="{StaticResource CardDescription}" Text="{x:Static res:Strings.HotkeyUndoDescription}" />
                </StackPanel>
              </ui:CardControl.Header>
              <controls:HotkeyBox
                Width="220"
                Style="{StaticResource {x:Type TextBox}}"
                HorizontalContentAlignment="Center"
                Hotkey="{Binding UndoHotkey}"
                IsRecording="{Binding IsRecordingHotkey}"
                AutomationProperties.Name="{x:Static res:Strings.HotkeyUndoTitle}" />
            </ui:CardControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="WindowApps24" Margin="0,0,6,0" />
            <TextBlock Text="{x:Static res:Strings.SectionAutoCenter}" />
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,12,12,24">
            <ui:CardControl Margin="0,0,0,4">
              <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="WindowApps24" />
              </ui:CardControl.Icon>
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Style="{StaticResource CardTitle}" Text="{x:Static res:Strings.AutoModeTitle}" />
                  <ui:TextBlock Style="{StaticResource CardDescription}" Text="{x:Static res:Strings.AutoModeDescription}" />
                </StackPanel>
              </ui:CardControl.Header>
              <ComboBox MinWidth="240" ItemsSource="{Binding AutoCenterModeOptions}" SelectedItem="{Binding SelectedAutoCenterMode}"
                        DisplayMemberPath="Title" AutomationProperties.Name="{x:Static res:Strings.AutoModeTitle}" />
            </ui:CardControl>

            <!-- Above the list: it can get long, the buttons must not scroll away. -->
            <WrapPanel Margin="0,8,0,4">
              <ui:Button Margin="0,0,8,8" Appearance="Primary" Content="{x:Static res:Strings.AddRunning}" Command="{Binding AddRunningAppCommand}">
                <ui:Button.Icon>
                  <ui:SymbolIcon Symbol="Add24" />
                </ui:Button.Icon>
              </ui:Button>
              <ui:Button x:Name="CrosshairButton" Margin="0,0,8,8" Content="{x:Static res:Strings.AddByCrosshair}"
                         ToolTip="{x:Static res:Strings.AddByCrosshairTooltip}" Cursor="Cross">
                <ui:Button.Icon>
                  <ui:SymbolIcon Symbol="Target24" />
                </ui:Button.Icon>
              </ui:Button>
              <ui:Button Margin="0,0,8,8" Content="{x:Static res:Strings.AddExe}" Command="{Binding AddExecutableCommand}">
                <ui:Button.Icon>
                  <ui:SymbolIcon Symbol="FolderOpen24" />
                </ui:Button.Icon>
              </ui:Button>
            </WrapPanel>

            <ui:Card Margin="0,0,0,4" Visibility="{Binding HasRules, Converter={StaticResource FalseToVisible}}">
              <ui:TextBlock Appearance="Secondary" TextWrapping="Wrap" Text="{Binding RulesEmptyText}" />
            </ui:Card>

            <ItemsControl ItemsSource="{Binding Rules}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:RuleItemViewModel}">
                  <ui:CardExpander Margin="0,0,0,4" ContentPadding="16,8,16,12">
                    <ui:CardExpander.Header>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Width="24" Height="24" Margin="0,0,16,0" Source="{Binding Icon}"
                               Visibility="{Binding Icon, Converter={StaticResource NullToCollapsed}}" />
                        <ui:SymbolIcon Margin="0,0,16,0" Symbol="AppGeneric24" FontSize="24"
                                       Visibility="{Binding Icon, Converter={StaticResource NullToVisible}}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <ui:TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                          <ui:TextBlock Style="{StaticResource CardDescription}" Text="{Binding ProcessName}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="2" Margin="12,0,8,0" IsChecked="{Binding IsEnabled}"
                                         AutomationProperties.Name="{Binding Title}" />
                      </Grid>
                    </ui:CardExpander.Header>
                    <StackPanel>
                      <StackPanel Margin="0,0,0,12" Visibility="{Binding IsCentering, Converter={StaticResource TrueToVisible}}">
                        <CheckBox IsChecked="{Binding OnlyFirstWindow}" Content="{x:Static res:Strings.RuleOnlyFirstWindow}" />
                        <CheckBox Margin="0,4,0,0" IsChecked="{Binding IncludeDialogs}" Content="{x:Static res:Strings.RuleIncludeDialogs}" />
                      </StackPanel>
                      <ui:Button Appearance="Danger" Content="{x:Static res:Strings.RuleRemove}" Command="{Binding RemoveCommand}">
                        <ui:Button.Icon>
                          <ui:SymbolIcon Symbol="Delete24" />
                        </ui:Button.Icon>
                      </ui:Button>
                    </StackPanel>
                  </ui:CardExpander>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Settings24" Margin="0,0,6,0" />
            <TextBlock Text="{x:Static res:Strings.SectionGeneral}" />
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,12,12,24">
            <ui:CardControl Margin="0,0,0,4">
              <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="ArrowMaximize24" />
              </ui:CardControl.Icon>
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Style="{StaticResource CardTitle}" Text="{x:Static res:Strings.OversizeTitle}" />
                  <ui:TextBlock Style="{StaticResource CardDescription}" Text="{x:Static res:Strings.OversizeDescription}" />
                </StackPanel>
              </ui:CardControl.Header>
              <ComboBox MinWidth="240" ItemsSource="{Binding OversizeOptions}" SelectedItem="{Binding SelectedOversize}"
                        DisplayMemberPath="Title" AutomationProperties.Name="{x:Static res:Strings.OversizeTitle}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4">
              <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Rocket24" />
              </ui:CardControl.Icon>
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Style="{StaticResource CardTitle}" Text="{x:Static res:Strings.AutostartTitle}" />
                  <ui:TextBlock Style="{StaticResource CardDescription}" Text="{x:Static res:Strings.AutostartDescription}" />
                </StackPanel>
              </ui:CardControl.Header>
              <ComboBox MinWidth="240" ItemsSource="{Binding AutostartOptions}" SelectedItem="{Binding SelectedAutostart}"
                        DisplayMemberPath="Title" IsEnabled="{Binding IsAutostartEditable}"
                        AutomationProperties.Name="{x:Static res:Strings.AutostartTitle}" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4">
              <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="ShieldKeyhole24" />
              </ui:CardControl.Icon>
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Style="{StaticResource CardTitle}" Text="{x:Static res:Strings.AdminTitle}" />
                  <ui:TextBlock Style="{StaticResource CardDescription}" Text="{x:Static res:Strings.AdminDescription}" />
                </StackPanel>
              </ui:CardControl.Header>
              <Grid>
                <ui:Button Content="{x:Static res:Strings.AdminRestart}" Command="{Binding RestartElevatedCommand}"
                           Visibility="{Binding IsElevated, Converter={StaticResource FalseToVisible}}">
                  <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Shield24" />
                  </ui:Button.Icon>
                </ui:Button>
                <ui:TextBlock VerticalAlignment="Center" Appearance="Secondary" Text="{x:Static res:Strings.AdminRunning}"
                              Visibility="{Binding IsElevated, Converter={StaticResource TrueToVisible}}" />
              </Grid>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4">
              <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="LocalLanguage24" />
              </ui:CardControl.Icon>
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Style="{StaticResource CardTitle}" Text="{x:Static res:Strings.LanguageTitle}" />
                  <ui:TextBlock Style="{StaticResource CardDescription}" Text="{x:Static res:Strings.LanguageDescription}" />
                </StackPanel>
              </ui:CardControl.Header>
              <StackPanel Orientation="Horizontal">
                <ui:Button Margin="0,0,8,0" Appearance="Primary" Content="{x:Static res:Strings.RestartNow}" Command="{Binding RestartCommand}"
                           Visibility="{Binding IsRestartRequired, Converter={StaticResource TrueToVisible}}" />
                <ComboBox MinWidth="160" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}"
                          DisplayMemberPath="Title" AutomationProperties.Name="{x:Static res:Strings.LanguageTitle}" />
              </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4" Visibility="{Binding AreUpdatesSupported, Converter={StaticResource TrueToVisible}}">
              <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="ArrowSync24" />
              </ui:CardControl.Icon>
              <ui:CardControl.Header>
                <StackPanel>
                  <ui:TextBlock Style="{StaticResource CardTitle}" Text="{x:Static res:Strings.UpdatesTitle}" />
                  <ui:TextBlock Style="{StaticResource CardDescription}" Text="{Binding UpdateStatus}" />
                  <CheckBox Margin="0,4,0,0" IsChecked="{Binding CheckForUpdatesAutomatically}" Content="{x:Static res:Strings.UpdatesAutoCheck}" />
                </StackPanel>
              </ui:CardControl.Header>
              <Grid>
                <ui:Button Content="{x:Static res:Strings.UpdatesCheckNow}" Command="{Binding CheckForUpdatesCommand}"
                           Visibility="{Binding IsUpdateAvailable, Converter={StaticResource FalseToVisible}}" />
                <ui:Button Appearance="Primary" Content="{x:Static res:Strings.UpdatesInstall}" Command="{Binding InstallUpdateCommand}"
                           Visibility="{Binding IsUpdateAvailable, Converter={StaticResource TrueToVisible}}" />
              </Grid>
            </ui:CardControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- Footer: always visible, below the tabs. -->
    <Grid Grid.Row="3" Margin="24,8,24,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <ui:Button Appearance="Transparent" Command="{Binding OpenSettingsFolderCommand}" Content="{x:Static res:Strings.SettingsFolder}">
          <ui:Button.Icon>
            <ui:SymbolIcon Symbol="Folder24" />
          </ui:Button.Icon>
        </ui:Button>
        <ui:Button Margin="8,0,0,0" Appearance="Transparent" Command="{Binding OpenLogsFolderCommand}" Content="{x:Static res:Strings.Logs}">
          <ui:Button.Icon>
            <ui:SymbolIcon Symbol="DocumentText24" />
          </ui:Button.Icon>
        </ui:Button>
        <ui:TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Appearance="Tertiary" FontTypography="Caption" Text="{Binding VersionText}" />
      </StackPanel>
      <!-- "__" escapes the underscore, a single one would mark an access key and disappear. -->
      <ui:HyperlinkButton Grid.Column="1" NavigateUri="https://t.me/ducker_dev" Content="@ducker__dev"
                          ToolTip="{x:Static res:Strings.TelegramTooltip}"
                          AutomationProperties.Name="{x:Static res:Strings.TelegramTooltip}">
        <ui:HyperlinkButton.Icon>
          <ui:SymbolIcon Symbol="Send24" />
        </ui:HyperlinkButton.Icon>
      </ui:HyperlinkButton>
    </Grid>

    <ui:ContentDialogHost x:Name="DialogHost" Grid.Row="0" Grid.RowSpan="4" />
  </Grid>
</ui:FluentWindow>
